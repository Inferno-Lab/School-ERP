{
  "name": "edunest",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:db": "pnpm --filter @edunest/db-tools dev:db",
    "dev": "turbo run dev --parallel",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
