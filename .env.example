# Copy to .env for local development. Never commit real values.
REGISTRY_DATABASE_URL=postgres://edunest:edunest@127.0.0.1:54329/registry
SHARED_PG_ADMIN_URL=postgres://edunest:edunest@127.0.0.1:54329/postgres
# At least 32 characters in production, and different from JWT_SECRET.
SECRETS_KEY=change-me-to-a-long-random-string-0123456789
JWT_SECRET=change-me-to-another-long-random-string-0123
# Previous JWT secret during a rotation. Leave unset otherwise.
# JWT_SECRET_PREVIOUS=
PORT=4000
# In production this must be the admin and console origins, not *.
CORS_ORIGINS=*
ADMIN_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
# Demo only: a fixed sign-in code for the console and demo schools.
# In production SEED_DEMO and DEMO_CODE are refused unless ALLOW_DEMO=true.
DEMO_CODE=424242
# ALLOW_DEMO=false
# Tenant pools: TENANT_MAX_POOLS × TENANT_PER_POOL, plus ~8 for the registry
# and ~8 for the console, must stay under Postgres max_connections (often 100).
# Defaults 40 × 5 = 200 — too high for a small server. A 100-connection instance
# can use 12 × 3 = 36 plus ~16 ≈ 52.
TENANT_MAX_POOLS=12
TENANT_PER_POOL=3
# Optional: Neon API key for one project per test school; GitHub for build profiles and app builds.
# NEON_API_KEY=
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo
