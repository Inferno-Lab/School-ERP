{
  "name": "@edunest/console-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@edunest/config-engine": "workspace:*",
    "@edunest/contracts": "workspace:*",
    "@edunest/db": "workspace:*",
    "@edunest/nest-kit": "workspace:*",
    "@edunest/security": "workspace:*",
    "@edunest/tenancy": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.11",
    "@edunest/api": "workspace:*"
  }
}